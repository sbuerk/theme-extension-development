includes:
  - phpstan-baseline.neon
  - ../../../.Build/vendor/saschaegerer/phpstan-typo3/extension.neon
  - ../../../.Build/vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
  # Use local .cache dir instead of /tmp
  tmpDir: ../../../.cache/phpstan

  level: 8

  # Doc types must not be trusted 100%, especially for globals and test
  # assertions verifying the runtime contract. Mirrors the TYPO3 core setting.
  treatPhpDocTypesAsCertain: false

  # One configuration per supported core version, each analysing only its own
  # "Core<major>/" sources: a directory written for a different core version may
  # use API that does not exist here, so it is never in this path list. As long
  # as a single version is supported there is exactly one such directory and
  # nothing under "Tests/" has to be excluded either; a second supported version
  # gets its own directory beside this one, not a widened path list here.
  paths:
    - ../../../Classes
    - ../../../Configuration
    - ../../../Core13
    - ../../../Tests
