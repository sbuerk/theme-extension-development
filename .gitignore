/.DS_Store
/.idea

# Working tree of AI coding agents: plans, reports and scratch files.
# See AGENTS.md — nothing below it is ever committed.
/.agent

# Agent tool configuration and personal, machine-local instructions.
/.claude
/CLAUDE.local.md
/GEMINI.local.md
/AGENTS.local.md

/.Build
/var

# Frontend asset build. "node_modules" is installed by "runTests.sh -s buildCss",
# the source maps are written by the development build only - the committed
# stylesheet is built without them.
/node_modules
/Resources/Public/Css/*.map

# Composer download and phpstan result cache. Deliberately NOT under ".Build/":
# "runTests.sh -s composerUpdate" starts with "rm -rf .Build", which would throw
# the cache away on every dependency install and make caching it in CI pointless.
/.cache

/.direnv
/.envrc

/.php-cs-fixer.cache
/composer.json.orig
/composer.json.testing
/composer.lock

/Documentation-GENERATED-temp

# Everything the development instances generate. What stays committed is their
# DDEV configuration, their composer.json and their "config/system" - see
# "docs/development/instances.md".
#
# The lock files are ignored on purpose, unlike in some reference setups: the
# root "composer.lock" of this repository is ignored for the same reason, and a
# development instance is meant to install the current patch level rather than
# a pinned one.
/instance-core-*/.cache/
/instance-core-*/composer.lock
/instance-core-*/config/system/additional/*.php
/instance-core-*/public/
/instance-core-*/var/
/instance-core-*/vendor/

# What DDEV writes into ".ddev/" the first time an instance is started -
# rendered compose files and image build contexts. Everything it generates
# there is dot prefixed, and everything committed on purpose is not, so the one
# rule separates them: "config.yaml" and "docker-compose.mounts.yaml" stay.
#
# DDEV normally drops its own ".ddev/.gitignore" covering these. It is not
# there after a plain "ddev config", so relying on it means the artifacts land
# in a commit the first time somebody starts an instance.
/instance-core-*/.ddev/.*

# Generated by the TYPO3 testing framework during functional test runs
/packages

/tailor-version-artefact/
/tailor-version-upload/
