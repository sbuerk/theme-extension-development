# TypoScript of the fixture extension, loaded by the functional tests through
# setUpFrontendRootPage().
#
# It renders the content elements of the default column and nothing else. The
# rendering definition of the plugin generated by ExtensionUtility::configurePlugin()
# is deliberately overridden below.

page = PAGE
page {
    typeNum = 0

    10 = CONTENT
    10 {
        table = tt_content
        select {
            orderBy = sorting
            where = {#colPos} = 0
        }
    }
}

# The generated definition is "=< lib.contentElement", an object this file
# does not define. It comes from the content rendering a site includes: this
# theme's own "Configuration/TypoScript/ContentElements.typoscript" or
# EXT:fluid_styled_content - not a dependency here. A fixture extension has no
# business depending on either just to render a plugin, so the content object
# is defined directly instead.
tt_content.testsexamplefixture_hello = COA
tt_content.testsexamplefixture_hello {
    10 = EXTBASEPLUGIN
    10 {
        extensionName = TestsExampleFixture
        pluginName = Hello
    }
}
