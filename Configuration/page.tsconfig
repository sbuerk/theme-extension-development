# Registers the theme's backend layouts.
#
# Page TSconfig, not a "backend_layout" database record and not a custom
# DataProvider: TYPO3 auto-loads "Configuration/page.tsconfig" from every
# package since v12.0 (#96614), so no registration call and no DB seeding is
# needed, and it applies identically whether the theme is pulled in through
# the site set or through the classic "sys_template" static include - the two
# alternatives would each only work for one of those.
#
# One "@import" per layout file, so a site package can override a single
# layout without touching the rest. "@import" of an exact file path (as
# opposed to a "*" wildcard or a directory) includes exactly that file - see
# "TYPO3\CMS\Core\TypoScript\IncludeTree\TreeFromLineStreamBuilder::processAtImport()".
#
# Every column carries an "identifier" as well as a "name" and a "colPos".
# TYPO3 v13.4 reads it - "GridColumn::__construct()" takes it from the column
# definition and "getIdentifierCleaned()" turns it into the
# "t3-grid-cell-<identifier>" class the page module puts on the column
# ("Resources/Private/Partials/PageLayout/Grid/Column.html") - so there it is
# a stable hook rather than decoration. TYPO3 v12.4 reads no column
# identifier: its "GridColumn::__construct()" keeps the column definition but
# reads only the "colPos", the "name", the "icon" and the spans out of it, so
# there the key is carried along unused. The identifiers are the slot names
# the "lib.content.*" objects use, which is also what a later move to PAGEVIEW
# would address a content area by, so one vocabulary covers the layout
# definition and the rendering.
@import 'EXT:theme_extension_development/Configuration/PageTsConfig/BackendLayouts/Default.tsconfig'
@import 'EXT:theme_extension_development/Configuration/PageTsConfig/BackendLayouts/Content.tsconfig'
@import 'EXT:theme_extension_development/Configuration/PageTsConfig/BackendLayouts/ContentSidebar.tsconfig'
@import 'EXT:theme_extension_development/Configuration/PageTsConfig/BackendLayouts/Start.tsconfig'
@import 'EXT:theme_extension_development/Configuration/PageTsConfig/BackendLayouts/TwoColumns.tsconfig'
@import 'EXT:theme_extension_development/Configuration/PageTsConfig/BackendLayouts/TwoColumnsWide.tsconfig'
@import 'EXT:theme_extension_development/Configuration/PageTsConfig/BackendLayouts/ThreeColumns.tsconfig'
@import 'EXT:theme_extension_development/Configuration/PageTsConfig/BackendLayouts/Article.tsconfig'
@import 'EXT:theme_extension_development/Configuration/PageTsConfig/BackendLayouts/Cover.tsconfig'
@import 'EXT:theme_extension_development/Configuration/PageTsConfig/BackendLayouts/Bands.tsconfig'
@import 'EXT:theme_extension_development/Configuration/PageTsConfig/BackendLayouts/Styleguide.tsconfig'
@import 'EXT:theme_extension_development/Configuration/PageTsConfig/BackendLayouts/Forms.tsconfig'

# Registers the theme's content elements in the "new content element" wizard on
# TYPO3 v12, where the wizard is still page TSconfig and not derived from the
# TCA. The imported file carries the version condition and the reasoning; it is
# imported unconditionally here so the condition lives in exactly one place.
#
# @todo Remove this import together with the imported file as soon as support
#       for TYPO3 v12 is dropped.
@import 'EXT:theme_extension_development/Configuration/PageTsConfig/NewContentElementWizard.tsconfig'

# The table modifiers an editor can pick beyond the two the core offers. Here
# for the same reason as the layouts: it applies through the site set and the
# static include alike.
@import 'EXT:theme_extension_development/Configuration/PageTsConfig/TCEFORM/TableClass.tsconfig'

# The appearance fields of a content element: the bands the theme adds to
# "frame_class", and the fields it does not render taken out of the form. From
# this file for the same reason as the backend layouts - it reaches both
# delivery paths, where the page TSconfig of a site set would reach only one.
@import 'EXT:theme_extension_development/Configuration/PageTsConfig/ContentElementAppearance.tsconfig'

# The rich text preset of the theme, for the same reason: both delivery paths.
@import 'EXT:theme_extension_development/Configuration/PageTsConfig/Rte.tsconfig'

# The icons an icon field offers by default - loaded the same way, for the same
# reason: one file applies to the site set and to the static include alike.
@import 'EXT:theme_extension_development/Configuration/PageTsConfig/IconPicker.tsconfig'
