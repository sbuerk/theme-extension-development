# "default" is also the hard-coded fallback identifier the core's
# "PageLayoutResolver" returns when neither a page nor any of its ancestors
# has a "backend_layout"/"backend_layout_next_level" set - so every page
# reaches this layout unless one of the others below is picked explicitly, and
# it has to exist on its own, not just be selectable. The method is
# "getLayoutForPage()" of "TYPO3\CMS\Frontend\Page\PageLayoutResolver" on
# TYPO3 v12.4 and "getLayoutIdentifierForPage()" of
# "TYPO3\CMS\Core\Page\PageLayoutResolver" on v13.4.
#
# One full-width column: the least a page can render and still be usable.
mod.web_layout.BackendLayouts.default {
    title = LLL:EXT:theme_extension_development/Resources/Private/Language/locallang.xlf:backendLayout.default.title
    config.backend_layout {
        colCount = 1
        rowCount = 1
        rows.1.columns.1 {
            name = LLL:EXT:theme_extension_development/Resources/Private/Language/locallang.xlf:backendLayout.colPos.main.name
            identifier = main
            colPos = 0
        }
    }
}
