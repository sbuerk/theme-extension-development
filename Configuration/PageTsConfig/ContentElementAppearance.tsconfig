# The appearance fields of a content element: what the theme renders, and
# nothing it does not.
#
# "Layouts/ContentElement.html" and "Partials/ContentElement/Header.html"
# turn "frame_class", "space_before_class", "space_after_class",
# "header_position" and "tx_theme_header_style" into modifiers. What is left of
# the core "Appearance" tab would be a field an editor sets and nothing
# happens - so it is taken out of the form rather than left inert.
#
# The same syntax on TYPO3 v13.4 and v14.3; "Configuration/page.tsconfig"
# imports this file, so it applies whether the theme is delivered by the site
# set or by the static include.
TCEFORM.tt_content {
    # The core offers rulers and indents, which the theme does not draw. It
    # draws four bands, and "none": the element without its inner padding.
    # "default" stays. Records still carrying one of the removed values render
    # as "default" - the layout matches known values only.
    frame_class {
        removeItems = ruler-before, ruler-after, indent, indent-left, indent-right
        addItems {
            surface = LLL:EXT:theme_extension_development/Resources/Private/Language/locallang_tca.xlf:tt_content.frame_class.surface
            raised = LLL:EXT:theme_extension_development/Resources/Private/Language/locallang_tca.xlf:tt_content.frame_class.raised
            accent = LLL:EXT:theme_extension_development/Resources/Private/Language/locallang_tca.xlf:tt_content.frame_class.accent
            inverse = LLL:EXT:theme_extension_development/Resources/Private/Language/locallang_tca.xlf:tt_content.frame_class.inverse
        }
    }

    # "layout" has a rendering only where a content element gives it one, and
    # is re-enabled for that CType alone - "PageTsConfigMerged" merges
    # "types.<CType>" over the field, so "disabled = 0" there wins over the
    # "1" here for that type and no other.
    #
    # "bullets" maps it onto the modifiers of ".theme-list"
    # ("Templates/ContentElements/Bullets.html"). The core labels its four
    # values "Default" and "Layout 1" to "Layout 3", which says nothing about
    # a list, so they are relabelled for this CType.
    layout.disabled = 1
    layout.types.bullets {
        disabled = 0
        altLabels {
            0 = LLL:EXT:theme_extension_development/Resources/Private/Language/locallang_tca.xlf:tt_content.layout.bullets.I.0
            1 = LLL:EXT:theme_extension_development/Resources/Private/Language/locallang_tca.xlf:tt_content.layout.bullets.I.1
            2 = LLL:EXT:theme_extension_development/Resources/Private/Language/locallang_tca.xlf:tt_content.layout.bullets.I.2
            3 = LLL:EXT:theme_extension_development/Resources/Private/Language/locallang_tca.xlf:tt_content.layout.bullets.I.3
        }
    }

    # "theme_features" maps it onto the item layout of ".theme-feature"
    # ("Templates/ContentElements/ThemeFeatures.html"); the same four values,
    # labelled for features.
    layout.types.theme_features {
        disabled = 0
        altLabels {
            0 = LLL:EXT:theme_extension_development/Resources/Private/Language/locallang_tca.xlf:tt_content.layout.theme_features.I.0
            1 = LLL:EXT:theme_extension_development/Resources/Private/Language/locallang_tca.xlf:tt_content.layout.theme_features.I.1
            2 = LLL:EXT:theme_extension_development/Resources/Private/Language/locallang_tca.xlf:tt_content.layout.theme_features.I.2
            3 = LLL:EXT:theme_extension_development/Resources/Private/Language/locallang_tca.xlf:tt_content.layout.theme_features.I.3
        }
    }

    # "text" maps "1" onto ".theme-text--columns"
    # ("Templates/ContentElements/Text.html"). The text element has one look
    # besides its default, so the two values it does not render are taken out
    # of the select for this CType rather than offered as layouts that look
    # like the default.
    layout.types.text {
        disabled = 0
        removeItems = 2, 3
        altLabels {
            0 = LLL:EXT:theme_extension_development/Resources/Private/Language/locallang_tca.xlf:tt_content.layout.text.I.0
            1 = LLL:EXT:theme_extension_development/Resources/Private/Language/locallang_tca.xlf:tt_content.layout.text.I.1
        }
    }

    # The layouts of a hero ("tx_theme_hero_layout", rendered by
    # "Partials/ContentElement/Hero.html"), narrowed to what each hero can
    # show. The reduced hero has too little height for an image cut off at an
    # edge; the hero without media has no image to place at all.
    tx_theme_hero_layout.types {
        theme_hero_small.removeItems = screenshot, bordered
        theme_hero_text_only.removeItems = image-end, screenshot, bordered
    }

    # "theme_card_group" arranges its cards by "layout": the grid (0) or one
    # row that scrolls sideways (1), ".theme-card-grid--scroller" in
    # "Templates/ContentElements/ThemeCardGroup.html". The two core values
    # the element does not render are removed for this type, and a record
    # still carrying one renders the grid.
    layout.types.theme_card_group {
        disabled = 0
        removeItems = 2,3
        altLabels {
            0 = LLL:EXT:theme_extension_development/Resources/Private/Language/locallang_tca.xlf:tt_content.layout.theme_card_group.I.0
            1 = LLL:EXT:theme_extension_development/Resources/Private/Language/locallang_tca.xlf:tt_content.layout.theme_card_group.I.1
        }
    }

    # "theme_split_tiles" takes "layout" for the foot the alternation starts
    # on: the default rhythm (0) or "--reversed" (1), which flips it - see
    # "Templates/ContentElements/ThemeSplitTiles.html". The picture side of an
    # individual tile is never a field: the stylesheet alternates it with
    # ":nth-child(even)". The two core values with no rendering are removed.
    layout.types.theme_split_tiles {
        disabled = 0
        removeItems = 2,3
        altLabels {
            0 = LLL:EXT:theme_extension_development/Resources/Private/Language/locallang_tca.xlf:tt_content.layout.theme_split_tiles.I.0
            1 = LLL:EXT:theme_extension_development/Resources/Private/Language/locallang_tca.xlf:tt_content.layout.theme_split_tiles.I.1
        }
    }

    # The two page menus show their pages as a list (0), as cards (1) or as
    # thumbnails (2) - "MenuPages.html", "MenuSubpages.html" and
    # "Partials/ContentElement/MenuCards.html". The core value 3 has no
    # rendering and is removed. Every other menu type keeps the field out of
    # the form: a sitemap of cards is not a sitemap.
    layout.types.menu_pages {
        disabled = 0
        removeItems = 3
        altLabels {
            0 = LLL:EXT:theme_extension_development/Resources/Private/Language/locallang_tca.xlf:tt_content.layout.menu.I.0
            1 = LLL:EXT:theme_extension_development/Resources/Private/Language/locallang_tca.xlf:tt_content.layout.menu.I.1
            2 = LLL:EXT:theme_extension_development/Resources/Private/Language/locallang_tca.xlf:tt_content.layout.menu.I.2
        }
    }

    layout.types.menu_subpages {
        disabled = 0
        removeItems = 3
        altLabels {
            0 = LLL:EXT:theme_extension_development/Resources/Private/Language/locallang_tca.xlf:tt_content.layout.menu.I.0
            1 = LLL:EXT:theme_extension_development/Resources/Private/Language/locallang_tca.xlf:tt_content.layout.menu.I.1
            2 = LLL:EXT:theme_extension_development/Resources/Private/Language/locallang_tca.xlf:tt_content.layout.menu.I.2
        }
    }

    # The section index and the link to the top of the page are a later
    # addition: a table of contents built from "sectionIndex" and a "back to
    # top" link behind "linkToTop". Until then both would be switches that
    # switch nothing. The "sectionIndex" column keeps its TCA default of 1, so
    # every element created meanwhile is part of the index once there is one.
    sectionIndex.disabled = 1
    linkToTop.disabled = 1

    # These CTypes carry the core "headers" palette but render their title in
    # a component of their own, outside the shared header partial, so neither
    # the position nor the look of the header reaches the page.
    header_position.types {
        theme_cta.disabled = 1
        theme_hero.disabled = 1
        theme_hero_small.disabled = 1
        theme_hero_text_only.disabled = 1
        theme_media_teaser.disabled = 1
        theme_testimonial.disabled = 1
    }

    tx_theme_header_style.types {
        theme_cta.disabled = 1
        theme_hero.disabled = 1
        theme_hero_small.disabled = 1
        theme_hero_text_only.disabled = 1
        theme_media_teaser.disabled = 1
        theme_testimonial.disabled = 1
    }
}
