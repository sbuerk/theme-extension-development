# Content column definitions of the theme.
#
# Read by the site set and by the classic static include alike - both point at
# "setup.typoscript", which "@import"s this file. See that file for the
# double-apply guard.
#
# One "CONTENT" object per slot under "lib.content.", rather than a single
# object switched by a variable, so a site package can override exactly one
# column - say "sidebar" - without repeating or touching the other five.
# Column numbers mirror "EXT:theme_camino", so content is portable between the
# two themes; see "docs/development/component-library.md" for the layout that
# uses each slot.

lib.content.main = CONTENT
lib.content.main {
    table = tt_content
    select {
        orderBy = sorting
        # Quoted through the QueryBuilder rather than a bare "colPos=0": TCA
        # backs "colPos" with an ANSI-reserved-adjacent identifier on some
        # DBMS, and "{#field}" is how a CONTENT/select "where" is told to run
        # through the QueryBuilder's field quoting instead of being
        # concatenated verbatim.
        where = {#colPos}=0
    }
}

lib.content.sidebar = CONTENT
lib.content.sidebar {
    table = tt_content
    select {
        orderBy = sorting
        where = {#colPos}=1
    }
}

# The second and third content column of the multi column page layouts
# ("two_columns", "two_columns_wide", "three_columns"). They carry no name of
# their own beyond their position: a column that is called "teaser" or "news"
# is a column a template has to know the purpose of, and these are decided by
# whatever an editor puts in them.
#
# No "slide": unlike the footer columns below, these are page content and an
# empty second column on a sub page means the page has none, not that it
# should show its parent's.

lib.content.secondary = CONTENT
lib.content.secondary {
    table = tt_content
    select {
        orderBy = sorting
        where = {#colPos}=3
    }
}

lib.content.tertiary = CONTENT
lib.content.tertiary {
    table = tt_content
    select {
        orderBy = sorting
        where = {#colPos}=4
    }
}

lib.content.stage = CONTENT
lib.content.stage {
    table = tt_content
    select {
        orderBy = sorting
        where = {#colPos}=2
    }
}

# The footer slots are edited once, on the site root page, and inherited by
# every page below it - "slide = -1" is what makes that happen.
#
# A CONTENT object normally reads only the current page's colPos. "slide"
# makes it walk the rootline instead: a positive number is a level count, and
# "-1" means walk upward without a limit, stopping the moment a page has
# content in that column (see ContentContentObject::render() - the loop
# continues only "while ... $slide && $tmpValue === ''"). With nothing placed
# on any page below the root, every page finds the root page's content, one
# level up or fifty - which is exactly what camino's "slideMode = slide"
# gets from EXT:fluid_styled_content's own "lib.contentElement" wiring,
# reproduced here without depending on that extension.
#
# "slide" IS A PROPERTY OF THE CONTENT OBJECT, NOT OF "select". These five
# carried it inside "select {}" for as long as they existed, where
# ContentContentObject never looks - it reads "slide" off the object's own
# configuration ("ContentContentObject::render()", first lines) and the query
# builder ignores a key it does not know, so nothing failed and nothing slid.
# It was invisible because no page of the showcase had anything in these
# columns to slide, which is the other half of the same defect. The gate is
# "ShowcaseTreeTest", in the test named after this slide: it renders a page
# four levels below the root and looks for the root's footer in it.

lib.content.footermeta = CONTENT
lib.content.footermeta {
    table = tt_content
    slide = -1
    select {
        orderBy = sorting
        where = {#colPos}=10
    }
}

lib.content.footer1 = CONTENT
lib.content.footer1 {
    table = tt_content
    slide = -1
    select {
        orderBy = sorting
        where = {#colPos}=11
    }
}

lib.content.footer2 = CONTENT
lib.content.footer2 {
    table = tt_content
    slide = -1
    select {
        orderBy = sorting
        where = {#colPos}=12
    }
}

lib.content.footer3 = CONTENT
lib.content.footer3 {
    table = tt_content
    slide = -1
    select {
        orderBy = sorting
        where = {#colPos}=13
    }
}

lib.content.footer4 = CONTENT
lib.content.footer4 {
    table = tt_content
    slide = -1
    select {
        orderBy = sorting
        where = {#colPos}=14
    }
}
