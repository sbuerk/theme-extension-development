# Setup of the theme.
#
# Read by the site set and by the classic static include alike - both point at
# this file, see "Configuration/Sets/ThemeExtensionDevelopment/config.yaml".

page = PAGE
page {
    typeNum = 0

    10 = FLUIDTEMPLATE
    10 {
        # @todo Derive the template from the backend layout once the theme
        #       ships backend layouts. Every page renders "Page/Default" until
        #       then, which is enough to look at a frontend and not enough to
        #       lay one out.
        templateName = Page/Default

        templateRootPaths.10 = {$theme.templateRootPath}
        partialRootPaths.10 = {$theme.partialRootPath}
        layoutRootPaths.10 = {$theme.layoutRootPath}

        variables {
            pageTitle = TEXT
            pageTitle.data = page:title
        }
    }

    includeCSS.themeExtensionDevelopment = {$theme.stylesheet}
}
