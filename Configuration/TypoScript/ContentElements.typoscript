# Content element rendering of the theme.
#
# The theme does not depend on "fluid_styled_content", so nothing renders a
# content element unless it is defined here. Without a definition the core
# renders its own notice that the element has no rendering definition - the
# yellow box - which is what every element looked like before this file.
#
# What FSC supplies is the *rendering*, not the TCA. EXT:frontend registers the
# whole classic set of content types itself, in
# "Configuration/TCA/Overrides/2xx-tt_content-content_type-*.php" - image,
# textmedia, bullets, table, uploads, the menus, shortcut, div and html - on
# v13.4 and v14 alike, and FSC's own "Configuration/TCA/Overrides/" holds
# nothing but a "sys_template.php". Every one of those elements can therefore be
# created in the backend of an installation using this theme, and every one that
# has no branch below renders the notice.
#
# Covered here: header, text, image, textpic, textmedia, bullets, table,
# uploads, shortcut, div, html, and every "menu_*" type EXT:frontend
# registers - the whole classic set. "menu_categorized_pages" and
# "menu_categorized_content" select by category rather than by rootline
# position and are built on "RECORDS" (see the comment above
# "tt_content.menu_categorized_pages" for why); the remaining nine are all
# "MenuProcessor" with a different "special" - see the comment above
# "tt_content.menu_pages", further down, for how that set is put together.

# The equivalent of "lib.contentElement" from "fluid_styled_content": the frame
# every content element is rendered through. Consumers of this theme can
# override the Fluid paths through the constants rather than this object.
lib.contentElement = FLUIDTEMPLATE
lib.contentElement {
    templateRootPaths.10 = {$theme.templateRootPath}
    partialRootPaths.10 = {$theme.partialRootPath}
    layoutRootPaths.10 = {$theme.layoutRootPath}
}

tt_content.header =< lib.contentElement
tt_content.header.templateName = ContentElements/Header

tt_content.text =< lib.contentElement
tt_content.text.templateName = ContentElements/Text

# The "Images" element. Its TCA - the "image" field, the gallery settings and
# the media adjustments - comes from EXT:frontend, so this is rendering only.
#
# The two processors are what turn the backend fields into a layout:
# "FilesProcessor" resolves the file references of the "image" field, and
# "GalleryProcessor" arranges them into rows and columns and computes a width
# and a height per image from "imagecols", "imageorient", "imagewidth",
# "imageheight" and "imageborder". Iterating the files in Fluid directly would
# render the images and silently ignore every one of those fields.
tt_content.image =< lib.contentElement
tt_content.image {
    templateName = ContentElements/Image

    dataProcessing {
        10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
        10 {
            references.fieldName = image
            as = files
        }

        20 = TYPO3\CMS\Frontend\DataProcessing\GalleryProcessor
        20 {
            filesProcessedDataKey = files
            mediaOrientation.field = imageorient
            numberOfColumns.field = imagecols
            equalMediaHeight.field = imageheight
            equalMediaWidth.field = imagewidth
            borderEnabled.field = imageborder
            maxGalleryWidth = {$theme.media.maxGalleryWidth}
            maxGalleryWidthInText = {$theme.media.maxGalleryWidthInText}
            # The gap between the columns is left out of the computation on
            # purpose. The processor would subtract it from the gallery width,
            # which only makes the computed image a few pixels narrower - while
            # it would have to be kept in sync with the CSS gap by hand, in two
            # languages, forever.
            columnSpacing = 0
            as = gallery
        }
    }
}

# The "Bullet List" element. "bodytext" is one item per line, which is
# exactly what the core's own "SplitProcessor" is for - see "Bullets.html"
# for why no processor of this extension's own was needed here.
tt_content.bullets =< lib.contentElement
tt_content.bullets {
    templateName = ContentElements/Bullets

    dataProcessing {
        10 = TYPO3\CMS\Frontend\DataProcessing\SplitProcessor
        10 {
            fieldName = bodytext
            removeEmptyEntries = 1
            as = bullets
        }
    }
}

# The "Table" element. "bodytext" is delimited/enclosed text; the delimiter
# and enclosure are TCA character CODES, and turning those into rows and
# columns needs its own processor - see "TableProcessor" and "Table.html" for
# why the core's "SplitProcessor" and "CommaSeparatedValueProcessor" were not
# enough on their own.
tt_content.table =< lib.contentElement
tt_content.table {
    templateName = ContentElements/Table

    dataProcessing {
        10 = SBUERK\ThemeExtensionDevelopment\DataProcessing\TableProcessor
        10 {
            as = table
        }
    }
}

# The "Text & Images" element. Same shape as "image" above - "FilesProcessor"
# plus "GalleryProcessor" - except the files come from "image" alongside a
# "bodytext" that the image element does not have. See
# "Templates/ContentElements/TextPic.html" for how "imageorient" decides where
# the gallery sits relative to the text.
tt_content.textpic =< lib.contentElement
tt_content.textpic {
    templateName = ContentElements/TextPic

    dataProcessing {
        10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
        10 {
            references.fieldName = image
            as = files
        }

        20 = TYPO3\CMS\Frontend\DataProcessing\GalleryProcessor
        20 {
            filesProcessedDataKey = files
            mediaOrientation.field = imageorient
            numberOfColumns.field = imagecols
            equalMediaHeight.field = imageheight
            equalMediaWidth.field = imagewidth
            borderEnabled.field = imageborder
            maxGalleryWidth = {$theme.media.maxGalleryWidth}
            maxGalleryWidthInText = {$theme.media.maxGalleryWidthInText}
            columnSpacing = 0
            as = gallery
        }
    }
}

# The "Text & Media" element. Identical to "textpic" apart from the source
# field: "assets" allows "common-media-types", not only images - see the core
# TCA in
# "Overrides/230-tt_content-content_type-textmedia.php". "GalleryProcessor"
# does not care which field the files came from.
tt_content.textmedia =< lib.contentElement
tt_content.textmedia {
    templateName = ContentElements/TextMedia

    dataProcessing {
        10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
        10 {
            references.fieldName = assets
            as = files
        }

        20 = TYPO3\CMS\Frontend\DataProcessing\GalleryProcessor
        20 {
            filesProcessedDataKey = files
            mediaOrientation.field = imageorient
            numberOfColumns.field = imagecols
            equalMediaHeight.field = imageheight
            equalMediaWidth.field = imagewidth
            borderEnabled.field = imageborder
            maxGalleryWidth = {$theme.media.maxGalleryWidth}
            maxGalleryWidthInText = {$theme.media.maxGalleryWidthInText}
            columnSpacing = 0
            as = gallery
        }
    }
}

# The "Uploads" element - a file list, not a gallery. "media" and
# "file_collections" are both valid sources in the core TCA (see
# "Overrides/245-tt_content-content_type-uploads.php"), so both are wired into
# "FilesProcessor"; leaving "file_collections" out would make that field's tab
# do nothing. "filelink_sorting"/"filelink_sorting_direction" order the merged
# list - "FilesProcessor" does that natively, so it never becomes a Fluid
# concern.
tt_content.uploads =< lib.contentElement
tt_content.uploads {
    templateName = ContentElements/Uploads

    dataProcessing {
        10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
        10 {
            references.fieldName = media
            collections.field = file_collections
            sorting.field = filelink_sorting
            sorting.direction.field = filelink_sorting_direction
            as = files
        }
    }
}

# The "Divider" element. Core TCA gives it a "header" field only, and that
# field's own label is overridden to "Name (not visible in frontend)" - see
# the comment in "Templates/ContentElements/Div.html". Nothing here needs
# rendering beyond the rule the template already draws.
tt_content.div =< lib.contentElement
tt_content.div.templateName = ContentElements/Div

# The "Plain HTML" element. Renders "bodytext" unescaped - see the comment in
# "Templates/ContentElements/Html.html" for why, and for what actually
# restricts it to admin users (the "CType" field's "authMode = explicitAllow",
# not anything specific to "html").
tt_content.html =< lib.contentElement
tt_content.html.templateName = ContentElements/Html

# The "Insert Records" element. "records" holds one or more "tt_content_<uid>"
# references, resolved here through the core's "RECORDS" cObject rather than
# anything of this theme's own - see "Templates/ContentElements/Shortcut.html".
#
# "conf.tt_content =< tt_content" makes every referenced record render through
# the very same CASE this file builds on (registered by EXT:frontend in its
# "ext_localconf.php": "tt_content = CASE" / "key.field = CType") - the
# referenced record renders exactly as it would on its own, including, if it
# is itself a "shortcut", going through this branch again.
#
# Recursion guard, verified in source rather than assumed
# (".Build/vendor/typo3/cms-frontend/Classes/ContentObject/RecordsContentObject.php"):
#   1. On TYPO3 v13.4 it does. "RecordsContentObject::render()" registers
#      "table:uid" in "TypoScriptFrontendController::$recordRegister" before
#      fetching, and skips any item already registered.
#   2. On TYPO3 v14 it does not. "TypoScriptFrontendController" was removed
#      entirely (Breaking #107831) and "$recordRegister" went with it - the
#      string does not occur anywhere in the v14 source outside its own
#      changelog. "RecordsContentObject::render()" on v14 renders every
#      referenced record unconditionally, and the older "cObjectDepthCounter"
#      that might have caught it was itself removed in v11.4, whose
#      deprecation note says PHP's own nesting limit is the expected outcome.
#      A shortcut pointing at itself therefore recurses until the process
#      dies.
#
# So the cycle is broken here rather than left to the core, and it is broken
# by construction rather than by a register: a shortcut reached *through* a
# shortcut renders nothing. One level of indirection is followed, which is all
# the element is for; a second is refused. That makes both the direct and the
# indirect cycle impossible on both core versions, with no state to keep and
# no version split - the difference is in what the core guarantees, not in
# what this theme does.
#
# @todo Revisit if a later v14 patch level restores a recursion guard. The
#       override below is harmless in that case, only redundant.
tt_content.shortcut =< lib.contentElement
tt_content.shortcut {
    templateName = ContentElements/Shortcut

    variables {
        records = RECORDS
        records {
            tables = tt_content
            source.field = records
            conf.tt_content =< tt_content

            # The cycle break. Inside a shortcut, the shortcut branch renders
            # nothing at all, so no chain of references can return to its
            # start. See the note above for why the core cannot be relied on
            # for this on v14.
            conf.tt_content.shortcut = TEXT
            conf.tt_content.shortcut.value =
        }
    }
}

# The "Categorized Pages" menu. "selected_categories" and "category_field"
# (EXT:frontend TCA,
# "Overrides/255-tt_content-content_type-menu_categorized_pages.php") pick
# pages by category membership, not by rootline position - "MenuProcessor"
# cannot express that at all (it only ever builds a menu from "HMENU", and
# none of "HMENU"'s own "special" modes reach into a category, except one -
# see below).
#
# HMENU does have a "special = categories"
# (".Build/vendor/typo3/cms-frontend/Classes/ContentObject/Menu/AbstractMenuContentObject.php",
# the "prepareMenuItems()" switch), backed by "CategoryMenuUtility::collectPages()"
# in the file alongside it. It was read and ruled out for a narrower reason
# than "cannot express it at all": "collectPages()" passes the literal string
# "'pages'" as the table argument to "CategoryCollection::load()" - hard-coded,
# not configurable - so it could only ever serve this element, never
# "menu_categorized_content" below, which needs the identical selection
# against "tt_content" instead.
#
# The core's "RECORDS" cObject serves both, table-agnostic by construction:
# its "categories"/"categories.relation" properties
# (".Build/vendor/typo3/cms-frontend/Classes/ContentObject/RecordsContentObject.php",
# "collectRecordsFromCategories()") are backed by that same
# "CategoryCollection::load()", called with whichever "$table" the
# surrounding "foreach ($tables as $table)" is currently on - "pages" here,
# "tt_content" below. One mechanism covers both elements, which is also why
# both are built on it rather than splitting the pair across "RECORDS" and
# "special = categories" for no structural reason.
#
# "DatabaseQueryProcessor" was read too and ruled out outright: its
# ".select" syntax (implemented in "getQuery()"/"exec_getQuery()" of
# "ContentObjectRenderer") has no notion of a category anywhere in it - a
# search for "categor" across the whole class matches nothing outside the
# two methods above. Using it here would mean hand-writing a WHERE clause
# against "sys_category_record_mm" for every call, which is exactly the raw
# SQL this theme avoids elsewhere (see "DataProcessing/TableProcessor.php").
#
# Each matched page is rendered by its own small FLUIDTEMPLATE
# ("Templates/ContentElements/Partials/CategorizedMenuPageItem.html") rather
# than a TypoScript-built string: "RECORDS" only ever concatenates whatever
# "conf.pages" returns for each match, and everything one item needs -
# "href"/attribute escaping and comparing the matched page against the page
# currently being rendered for "aria-current" - is safer left to Fluid than
# assembled by hand in TypoScript.
tt_content.menu_categorized_pages =< lib.contentElement
tt_content.menu_categorized_pages {
    templateName = ContentElements/MenuCategorizedPages

    variables {
        items = RECORDS
        items {
            tables = pages
            categories.field = selected_categories
            categories.relation.field = category_field

            conf.pages = FLUIDTEMPLATE
            conf.pages {
                templateName = ContentElements/Partials/CategorizedMenuPageItem
                templateRootPaths.10 = {$theme.templateRootPath}

                variables {
                    currentPageUid = TEXT
                    currentPageUid.data = page:uid
                }
            }
        }
    }
}

# The "Categorized Content" menu. Same selection as above, against
# "tt_content" instead of "pages" - see the comment there for why "RECORDS"
# rather than "MenuProcessor" or "DatabaseQueryProcessor". Unlike
# "menu_categorized_pages" this one renders content elements, not links to
# them: the TCA
# ("Overrides/255-tt_content-content_type-menu_categorized_content.php")
# gives it no "pages" field at all, only "selected_categories" and
# "category_field".
#
# Rendering another content element is exactly what "tt_content.shortcut"
# above does, and it carries the identical recursion exposure: a categorized
# content element can match itself by category, or match another categorized
# content element that matches it back, and "RecordsContentObject::render()"
# does not guard against that on TYPO3 v14 - see the long comment above
# "tt_content.shortcut" for what was verified in source there; nothing about
# that finding is specific to "shortcut", it is a property of "RECORDS"
# itself on v14.
#
# The same structural break is applied here, in the same shape: inside a
# categorized-content listing, a nested categorized-content element renders
# nothing, so a direct or indirect self-reference through this branch cannot
# return to where it started, on both core versions, with no state kept
# between requests. "conf.tt_content" is copied fresh per invocation (the
# "=<" below), so the override is local to this element's own rendering and
# never leaks into how any other element's "RECORDS" call resolves the same
# branch.
#
# What this does not cover, the same as "shortcut" does not cover it either:
# a *different* content type reached from inside this listing that itself
# embeds a reference back to this element - a shortcut inside a categorized
# listing pointing at that same listing, say - is not newly guarded by this
# change. Breaking every possible mixed-type cycle in the content graph is
# not what either guard does; each one only closes the direct/same-branch
# cycle its own element is exposed to, which is what "RecordsContentObject"
# needed replacing here.
#
# "RECORDS" gives no per-item boundary in "{items}" to hang the component's
# "<li>" on from Fluid - it only ever concatenates whatever each match
# renders - so the wrapper is added here instead, as the CASE cObject's own
# "stdWrap", which "CaseContentObject::render()" applies to whichever branch
# fired after it has rendered: every match gets the "<li>" regardless of its
# own CType.
tt_content.menu_categorized_content =< lib.contentElement
tt_content.menu_categorized_content {
    templateName = ContentElements/MenuCategorizedContent

    # A "DatabaseQueryProcessor" with an explicit join, not "RECORDS" with its
    # "categories" property, and not because "RECORDS" cannot select by
    # category - it can, and the sibling element above uses it for pages.
    #
    # The difference is what the two produce. "RECORDS" renders each match
    # through the content element CASE, so a menu of content would re-render
    # whole content elements inside itself: heavy, visually wrong for a menu,
    # and it inherits the recursion exposure documented above the shortcut
    # element, which on v14 has no core guard at all. This processor returns
    # the rows as data instead, so the template renders a list of links and
    # nothing can nest. The cycle simply cannot form.
    #
    # The join is the one "fluid_styled_content" itself used for this element -
    # the category relation lives in "sys_category_record_mm", and no
    # "select" syntax expresses it.
    dataProcessing {
        10 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
        10 {
            table = tt_content
            pidInList.data = leveluid : 0
            recursive = 99

            # A subquery rather than the join "fluid_styled_content" used here,
            # and the reason is portability rather than taste.
            #
            # A join against the MM table returns one row per matching category,
            # so it needs a "GROUP BY uid" to collapse them. That group is
            # invalid under ONLY_FULL_GROUP_BY, because "SELECT tt_content.*"
            # names columns the group does not. PostgreSQL and MySQL accept it
            # anyway - both infer the functional dependency from "uid" being the
            # primary key - and MariaDB does not implement that inference, so it
            # is the only DBMS of the four that rejects the query. It failed
            # there and nowhere else.
            #
            # "IN (subquery)" cannot multiply rows in the first place, so there
            # is nothing to group and the query is the same on every DBMS.
            #
            # Both interpolated values are TCA constrained: "selected_categories"
            # is a category relation, so integers, and "category_field" is a
            # select whose items are generated from the actual category fields
            # of the table. This is the same trust boundary the core's own
            # version relied on.
            where.cObject = TEXT
            where.cObject {
                value = {#uid} IN (SELECT {#uid_foreign} FROM {#sys_category_record_mm} WHERE {#uid_local} IN ({field:selected_categories}) AND {#tablenames} = 'tt_content' AND {#fieldname} = '{field:category_field}')
                insertData = 1
            }

            orderBy = tt_content.sorting
            as = items
        }
    }
}

# The remaining nine "menu_*" content types. All are core "MenuProcessor"
# (unchanged on v13.4 and v14.3, see "Configuration/TypoScript/Navigation.-
# typoscript") with a different "special" - the "special"/HMENU documentation
# and "AbstractMenuContentObject.php" were read for every one below, not
# guessed, and cross-checked against the historical "fluid_styled_content"
# TypoScript that originally rendered these same nine CTypes before TYPO3 v13
# made the TCA an "EXT:frontend"-only concern (github.com/TYPO3/typo3, tag
# "12.4",
# "typo3/sysext/fluid_styled_content/Configuration/TypoScript/ContentElement/
# Menu*.typoscript") - reproduced close to verbatim for seven of the nine.
#
# One full definition, "menu_pages" - every other type is "=< tt_content.
# menu_X" plus only the lines that actually differ, so the difference between
# the nine is what is visible in this file, not nine near-identical blocks.
# Each block below says what changed from its parent and why.
#
# "as = menu" throughout is deliberately not "as = mainMenu"/"subMenu" the
# way "Navigation.typoscript" names its three: these are content elements,
# each producing its own independent menu, not one of the three fixed page
# navigations every page carries.
tt_content.menu_pages =< lib.contentElement
tt_content.menu_pages {
    templateName = ContentElements/MenuPages

    # "special = list" - "pages" is a list of specific page uids, not a
    # rootline position, so "MenuProcessor" is told exactly which pages to
    # render rather than where to find them
    # ("prepareMenuItemsForListMenu()", "AbstractMenuContentObject.php:680").
    # Left empty (no "pages" selected), it falls back to "$this->id" - the
    # site root, via the standard "entryLevel" resolution every "HMENU" does
    # in "start()" (see "Navigation.typoscript" for why "mainMenu" resolves
    # the same way with no "special" set at all) - not the current page. See
    # "menu_section" below for the type that needs the current page instead
    # and overrides that fallback explicitly.
    dataProcessing {
        10 = TYPO3\CMS\Frontend\DataProcessing\MenuProcessor
        10 {
            as = menu
            special = list
            special.value.field = pages
        }
    }
}

# One level deeper than "menu_pages", and falling back to the *current* page
# rather than the site root when no "pages" are selected - the CType's own
# description ("Page content marked for section menus",
# "EXT:frontend/Resources/Private/Language/locallang_ttc.xlf:
# CType.menu_section.description") is about the page(s) this element itself
# sits among, not an arbitrary site-wide list. The override reproduces the
# one FSC's own "MenuSection.typoscript" used for the identical reason,
# minus its second-order "page:content_from_pid" fallback (the page a
# request was actually served from, when the current page borrows another
# page's content) - a narrower edge case, left out rather than carried along
# unread; "page:uid" (the current page as TYPO3 already knows it, no lookup
# needed) covers the case this element set was asked to cover.
#
# "levels = 2" is this theme's stand-in for "including sections": historical
# FSC additionally queried each page's own "tt_content" rows flagged
# "sectionIndex" and linked into them by anchor - out of scope here, the
# same way "menu_categorized_content" is the only element in this file that
# renders more than a link (see the comment above it) and "menu_abstract"/
# "menu_recently_updated" below are the only two among these nine that do -
# a fourth type quietly doing the same would contradict that. A second menu
# level - the pages themselves, and one level of their own children beneath
# each - is exactly "MenuProcessor" territory instead.
tt_content.menu_section =< tt_content.menu_pages
tt_content.menu_section {
    templateName = ContentElements/MenuSection

    dataProcessing.10 {
        special.value.override.data = page:uid
        special.value.override.if.isFalse.field = pages
        levels = 2
    }
}

# "special = directory" - the children of the selected "pages", not the
# pages themselves ("prepareMenuItemsForDirectoryMenu()",
# "AbstractMenuContentObject.php:639"). Left empty, its own fallback is
# already the *current* page
# ("$this->request->getAttribute('frontend.page.information')->getId()",
# line 643) - unlike "special = list" above, no override is needed to reach
# it.
tt_content.menu_subpages =< tt_content.menu_pages
tt_content.menu_subpages {
    templateName = ContentElements/MenuSubpages
    dataProcessing.10.special = directory
}

# "menu_subpages" plus one more level - the subpages' own children, standing
# in for "including sections" the same way "menu_section" does above, and
# for the identical reason (see that comment for what was left out).
tt_content.menu_section_pages =< tt_content.menu_subpages
tt_content.menu_section_pages {
    templateName = ContentElements/MenuSectionPages
    dataProcessing.10.levels = 2
}

# No "special" at all - "MenuProcessor"'s own default, the same one
# "Navigation.typoscript" uses for "mainMenu": "entryLevel" resolves to index
# 0 of the *local rootline*, the site root, regardless of which page this
# element sits on ("AbstractMenuContentObject::start()", line ~223 ff., and
# see "Navigation.typoscript" for the full "leveluid"/rootline-index
# reasoning). "levels = 7" then walks the whole site from that root - "an
# expanded menu of all subpages of the current site" per the CType's own
# description
# ("EXT:frontend/Resources/Private/Language/locallang_ttc.xlf:
# CType.menu_sitemap.description") - deep enough for any realistic page tree
# without being unbounded, matching FSC's own "MenuSitemap.typoscript".
# "special" is unset explicitly ("special >") rather than left to default,
# because this type is built "=< tt_content.menu_subpages" below, which did
# set one.
tt_content.menu_sitemap =< tt_content.menu_subpages
tt_content.menu_sitemap {
    templateName = ContentElements/MenuSitemap

    dataProcessing.10 {
        special >
        levels = 7
    }
}

# Same tree as "menu_sitemap", rooted at the selected "pages" instead of the
# site root - "special = directory" the same way "menu_subpages" uses it,
# just seven levels deep instead of one.
tt_content.menu_sitemap_pages =< tt_content.menu_subpages
tt_content.menu_sitemap_pages {
    templateName = ContentElements/MenuSitemapPages
    dataProcessing.10.levels = 7
}

# Same shape as "menu_subpages" - "special = directory" over "pages", one
# level. The difference is entirely in the template: "item.data.abstract" is
# already there for the reading, on the same page row "MenuProcessor" always
# puts at "item.data" (the "'*'"-selected page record HMENU fetches
# internally, JSON-encoded verbatim by "MenuProcessor::getDataAsJson()") -
# nothing had to be added with "dataProcessing" to reach it, unlike
# "menu_recently_updated" below where the same is true for a different
# reason. See the header comment of
# "Templates/ContentElements/MenuAbstract.html".
tt_content.menu_abstract =< tt_content.menu_subpages
tt_content.menu_abstract {
    templateName = ContentElements/MenuAbstract
}

# "special = updated" - "prepareMenuItemsForUpdatedMenu()",
# "AbstractMenuContentObject.php:736", sorts the page tree beneath "pages"
# (or, empty, the current page - same request-attribute fallback as
# "directory" above) by "SYS_LASTCHANGED" descending by default
# ("getMode()", same file). FSC's own "MenuRecentlyUpdated.typoscript" also
# sets "maxAge = 3600*24*7" - deliberately not reproduced here: a hard
# cutoff window is a display choice for a site package to make, not a
# default this theme should bake in, and an unset "maxAge" makes the age
# filter never apply (`if ($maxAge > 0)`, line 775) rather than the query
# silently returning nothing wherever "SYS_LASTCHANGED" has no real history
# yet. "excludeNoSearchPages" is kept - pages an editor marked out of search
# are the same pages that should stay out of a "what changed recently"
# listing.
#
# The template's "date" is "item.data.SYS_LASTCHANGED" - the very field the
# query above already sorts by, on the same "item.data" page row
# "menu_abstract" reads "abstract" from above; nothing had to be added with
# "dataProcessing" here either.
tt_content.menu_recently_updated =< tt_content.menu_pages
tt_content.menu_recently_updated {
    templateName = ContentElements/MenuRecentlyUpdated

    dataProcessing.10 {
        special = updated
        special.excludeNoSearchPages = 1
    }
}

# "special = keywords" - "prepareMenuItemsForKeywordsMenu()",
# "AbstractMenuContentObject.php:800": the page "pages" resolves to (or,
# empty, the current page) is matched against every other page under the
# same entry point sharing at least one of that page's own "keywords".
# "alternativeSortingField = title" and "excludeNoSearchPages" are both
# reproduced from FSC's own "MenuRelatedPages.typoscript" - an alphabetical
# related-pages list reads better than one ordered by an internal "tstamp"/
# "SYS_LASTCHANGED" sort field a reader never sees, and a page excluded from
# search has no business turning up as "related" either.
tt_content.menu_related_pages =< tt_content.menu_pages
tt_content.menu_related_pages {
    templateName = ContentElements/MenuRelatedPages

    dataProcessing.10 {
        special = keywords
        special.excludeNoSearchPages = 1
        alternativeSortingField = title
    }
}
