# Constants of the theme.
#
# Read by the site set and by the classic static include alike - both point at
# this file, see "Configuration/Sets/ThemeExtensionDevelopment/config.yaml".

theme {
    # Where the Fluid files are looked up. Override these to render your own
    # templates instead of editing the ones shipped here.
    templateRootPath = EXT:theme_extension_development/Resources/Private/Templates/
    partialRootPath = EXT:theme_extension_development/Resources/Private/Partials/
    layoutRootPath = EXT:theme_extension_development/Resources/Private/Layouts/

    # The compiled stylesheet. It is built from the SCSS sources below
    # "Resources/Private/Scss/" and committed - see
    # "docs/development/frontend-assets.md".
    stylesheet = EXT:theme_extension_development/Resources/Public/Css/theme.css

    # Whether a link to another site, a file, an email address or a phone
    # number is marked with a glyph after its text, and a link opening a new
    # window or a download says so to a screen reader. One of "1", "0" - see
    # "Configuration/TypoScript/LinkDecoration.typoscript".
    linkDecoration = 1

    header {
        # How the site header arranges the title, the navigation and the
        # controls: "simple" (one row, the default), "centred", "actions" or
        # "two-tier". See "Partials/Page/Header.html", which renders one
        # partial per value, and "layout/_site-header.scss".
        #
        # This is also a site setting of the same name
        # ("Configuration/Sets/ThemeExtensionDevelopment/settings.definitions.yaml").
        # A site that uses the set gets the setting, which overrules this
        # constant; a site on the classic static include gets this constant -
        # on TYPO3 v12, which has no site sets, every site does. A value of
        # the same key in the site's "settings.yaml" does not help there: the
        # core adds it as a constant before the static include, and this
        # default overrules it.
        variant = simple

        # The call to action of the "actions" header: the uid of the page it
        # leads to, and its text. A page uid rather than a link, so nothing
        # but a page can reach that "href" - a link field would accept a
        # scheme. Either left at its default renders no call to action.
        actionPage = 0
        actionLabel =
    }

    media {
        # The width in pixels the image gallery is computed for. No image is
        # processed wider than this, so it should match the width the layout
        # gives the content column - 1200px is the 75rem of
        # "--theme-content-max-width".
        maxGalleryWidth = 1200

        # The same, for an element positioned beside the text rather than above
        # or below it.
        maxGalleryWidthInText = 420
    }

    appearance {
        # The appearance rendered server side, before the no-flash script in
        # "Appearance.typoscript" can override it from "localStorage". One of
        # "auto", "light", "dark". "auto" means no "data-theme" attribute at
        # all - the operating system decides, via "color-scheme" - see
        # "abstracts/_tokens.scss".
        default = auto

        # The colour palette rendered into "data-palette". One of "neutral",
        # "ember", "ocean", "moss", "violet" - see "abstracts/_palettes.scss".
        # "neutral" has no "[data-palette='neutral']" rule of its own either -
        # it is simply what "_tokens.scss" already declares - but unlike
        # appearance's "auto" it is still rendered onto the tag: a palette has
        # no "operating system decides" case that an omitted attribute would
        # have to express.
        palette = neutral

        # Whether "components/_content-element.scss" draws the CType outline
        # and label. One of "on", "off". A development/staging affordance -
        # "off" for a production site package.
        contentOutline = on
    }
}
