/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.php-cs-fixer.cache export-ignore
/Build export-ignore
/Tests export-ignore
/.github export-ignore
/CONTRIBUTING.md export-ignore
/docs export-ignore
/AGENTS.md export-ignore
/CLAUDE.md export-ignore
/GEMINI.md export-ignore
/node_modules export-ignore

# The development instances and everything they need. None of it belongs in a
# distributed package - and "/theme" in particular is a symlink to the
# repository root, which must never end up inside a composer dist archive or a
# TER artifact.
/theme export-ignore
/instance-core-13 export-ignore
/packages-dev export-ignore
/sqlite-databases export-ignore

# "Resources/Private/Scss", "package.json" and "package-lock.json" are
# deliberately NOT export-ignored: the SCSS sources ship, so the rebuild path
# has to ship with them.

# Enforce checkout with linux lf consistent over all platforms
*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.php text eol=lf
*.rst text eol=lf
*.scss text eol=lf
*.sql text eol=lf
*.svg text eol=lf
*.tsconfig text eol=lf
*.txt text eol=lf
*.typoscript text eol=lf
*.xlf text eol=lf
*.xml text eol=lf
*.yml text eol=lf
